@using EITSTMS.Models.Entities
@using EITSTMS.Models.Enums
@model Asset

@{
    ViewData["Title"] = "添加资产";
}

<h2 class="mb-3">添加资产</h2>

<form asp-controller="Assets"
      asp-action="Create"
      method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <div class="mb-3">
        <label asp-for="AssetNumber"
               class="form-label">
            资产编号
        </label>

        <input asp-for="AssetNumber"
               class="form-control" />

        <span asp-validation-for="AssetNumber"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="AssetName"
               class="form-label">
            资产名称
        </label>

        <input asp-for="AssetName"
               class="form-control" />

        <span asp-validation-for="AssetName"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="Category"
               class="form-label">
            资产分类
        </label>

        <select asp-for="Category"
                asp-items="Html.GetEnumSelectList<AssetCategory>()"
                class="form-select">
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Status"
               class="form-label">
            资产状态
        </label>

        <select asp-for="Status"
                asp-items="Html.GetEnumSelectList<AssetStatus>()"
                class="form-select">
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Manufacturer"
               class="form-label">
            厂商
        </label>

        <input asp-for="Manufacturer"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Model"
               class="form-label">
            型号
        </label>

        <input asp-for="Model"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="SerialNumber"
               class="form-label">
            序列号
        </label>

        <input asp-for="SerialNumber"
               class="form-control" />
    </div>

    <button type="submit"
            class="btn btn-primary">
        添加
    </button>

    <a asp-controller="Assets"
       asp-action="Index"
       class="btn btn-secondary">
        返回
    </a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}