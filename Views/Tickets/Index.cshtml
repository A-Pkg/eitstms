<script>
    setInterval(function ()
    {
        document
            .querySelectorAll("[id^='ticket-status-']")
            .forEach(function(element)
            {
                let id = element.id.replace("ticket-status-", "");

                fetch('/Tickets/GetStatus?id=' + id)
                    .then(response => response.json())
                    .then(data =>
                    {
                        element.innerText = data.status;
                    });
            });
    },3000);
</script>