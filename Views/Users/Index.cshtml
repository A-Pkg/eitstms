@model IEnumerable<EITSTMS.Models.ViewModels.Users.UserListItemViewModel>

@{
    ViewData["Title"] = "用户管理";
}

<div class="d-flex justify-content-between align-items-center mb-3">

    <div>
        <h2 class="mb-1">用户管理</h2>
        <p class="text-muted mb-0">管理系统用户、账号状态和角色。</p>
    </div>

    <a asp-controller="Users"
       asp-action="Create"
       class="btn btn-primary">
        新建用户
    </a>

</div>

<div class="table-responsive">

    <table class="table table-hover align-middle">

        <thead class="table-light">
            <tr>
                <th>用户名</th>
                <th>员工编号</th>
                <th>姓名</th>
                <th>角色</th>
                <th>状态</th>
                <th>操作</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.UserName</td>

                    <td>@user.EmployeeNumber</td>

                    <td>@user.Name</td>

                    <td>
                        @foreach (var role in user.Roles)
                        {
                            <span class="badge bg-primary me-1">
                                @role
                            </span>
                        }
                    </td>

                    <td>
                        @if (user.IsActive)
                        {
                            <span class="badge bg-success">
                                启用
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                禁用
                            </span>
                        }
                    </td>

                    <td>
                        @if(user.CanEdit)
                        {
                            <a asp-controller="Users"
                               asp-action="Edit"
                               asp-route-id="@user.Id"
                               class="btn btn-outline-primary btn-sm">
                                编辑
                            </a>

                            <form asp-controller="Users"
                                  asp-action="ToggleStatus"
                                  asp-route-id="@user.Id"
                                  method="post"
                                  class="d-inline">

                                @if (user.IsActive)
                                {
                                    <button type="submit"
                                            class="btn btn-outline-danger btn-sm"
                                            onclick="return confirm('确定要禁用该用户吗？');">
                                        禁用
                                    </button>
                                }
                                else
                                {
                                    <button type="submit"
                                            class="btn btn-outline-success btn-sm"
                                            onclick="return confirm('确定要启用该用户吗？');">
                                        启用
                                    </button>
                                }

                            </form>
                        }
                        else
                        {
                            <span class="text-muted">不可编辑</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>